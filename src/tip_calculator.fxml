<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TipCalculatorController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>

   <!-- Title -->
   <Label text="Tip Calculator" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;">
      <font>
         <Font size="28.0" />
      </font>
   </Label>

   <!-- Bill Amount -->
   <Label text="Bill Amount ($)" style="-fx-font-size: 14px;" />
   <TextField fx:id="billAmountField" promptText="Enter bill amount" prefWidth="280.0" />

   <!-- Tip Percentage -->
   <Label text="Tip Percentage (%)" style="-fx-font-size: 14px;" />
   <TextField fx:id="tipPercentField" promptText="Enter tip percentage" prefWidth="280.0" />

   <!-- Buttons -->
   <HBox alignment="CENTER" spacing="20.0">
      <Button fx:id="calculateButton" text="Calculate Tip" onAction="#calculateTip"
              style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px;"
              prefWidth="130.0" prefHeight="35.0" />
      <Button fx:id="resetButton" text="Reset" onAction="#reset"
              style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px;"
              prefWidth="100.0" prefHeight="35.0" />
   </HBox>

   <!-- Result -->
   <Label fx:id="tipAmountLabel" text="Tip Amount: $0.00"
          style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />

   <!-- Error message -->
   <Label fx:id="errorLabel" text=""
          style="-fx-font-size: 13px; -fx-text-fill: #c0392b;" />
</VBox>
